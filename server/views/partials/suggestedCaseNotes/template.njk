<section class="govuk-!-margin-top-9" data-qa="suggested-case-notes-widget">
    <h2 class="govuk-heading-l govuk-!-margin-bottom-4">Suggested Case Notes</h2>
    {% if widget and widget.highlightToggleHref and widget.highlightToggleText and widget.notes and widget.notes.length %}
        <p class="govuk-body govuk-!-margin-bottom-4">
            <a class="govuk-link govuk-link--no-visited-state" href="{{ widget.highlightToggleHref }}">{{ widget.highlightToggleText }}</a>
        </p>
    {% endif %}
    {% if widget and widget.notes and widget.notes.length %}
        {% for note in widget.notes %}
            <div class="card case-note-card govuk-!-margin-bottom-4" data-qa="suggested-case-notes-card">
                <div class="case-note-card__header-info govuk-!-margin-bottom-3">
                    <div class="case-note-card__header-text">
                        <h3 class="govuk-heading-m govuk-!-margin-bottom-0 case-note-card__date">Suggested note {{ loop.index }}</h3>
                        <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0">Ref: {{ note.itemId }}</p>
                    </div>
                    <div class="case-note-card__score-item">
                        <p class="govuk-body-s govuk-!-margin-bottom-0">
                            <span class="case-note-card__score-label">Relevance:</span>
                            <span class="moj-badge {% if note.relevanceLabel === 'High' %}moj-badge--red{% elseif note.relevanceLabel === 'Medium' %}moj-badge--blue{% else %}moj-badge--grey{% endif %} suggested-case-notes__relevance-badge">{{ note.relevanceLabel }}</span>
                        </p>
                    </div>
                </div>

                <div class="case-note-card__details">
                    <p class="govuk-body govuk-!-margin-bottom-3 case-note-card__text">
                        {% if widget.showHighlighting and note.textFragments %}
                            {% for fragment in note.textFragments %}
                                {% if fragment.highlighted %}
                                    <mark class="hods-highlight"><strong>{{ fragment.text }}</strong></mark>
                                {% else %}
                                    {{ fragment.text }}
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            {{ note.caseNoteText }}
                        {% endif %}
                    </p>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="govuk-inset-text govuk-!-margin-top-2">
            {{ widget.emptyStateMessage if widget else 'No suggested case notes are available for this record right now.' }}
        </div>
    {% endif %}
</section>
