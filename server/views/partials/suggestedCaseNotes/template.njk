<section class="suggested-case-notes govuk-!-margin-top-9" data-qa="suggested-case-notes-widget" role="region" aria-live="polite" aria-label="Suggested case notes from Digital Prison Services">
    <div class="suggested-case-notes__heading">
        <h2 class="govuk-heading-l govuk-!-margin-bottom-4">Suggested Case Notes</h2>
        <a class="govuk-link govuk-link--no-visited-state" href="#">Give feedback</a>
    </div>
    <h3 class="govuk-heading-s govuk-!-margin-bottom-4">{% if prisoner %}An AI tool has identified {{ prisoner | firstNameSpaceLastName }}'s case notes relevant to this question.{% else %}An AI tool has identified case notes relevant to this question.{% endif %}</h3>
    <nav class="suggested-case-notes__controls" aria-label="Case notes display options">
        <div class="suggested-case-notes__control-group">
            {% if widget.sortField == 'createdDate' %}
                <a class="govuk-link govuk-link--no-visited-state" href="?sortField=lastAmendedDate" data-qa="sort-by-most-recent-activity">Sort by recently updated</a>
                <a class="govuk-link govuk-link--no-visited-state govuk-!-font-weight-bold font-colour--black govuk-link--no-underline" href="?sortField=createdDate" data-qa="sort-by-date-created">Sorted by date created</a>
            {% else %}
                <a class="govuk-link govuk-link--no-visited-state govuk-!-font-weight-bold font-colour--black govuk-link--no-underline" href="?sortField=lastAmendedDate" data-qa="sort-by-most-recent-activity">Sorted by recently updated</a>
                <a class="govuk-link govuk-link--no-visited-state" href="?sortField=createdDate" data-qa="sort-by-date-created">Sort by date created</a>
            {% endif %}
        </div>
        <div class="suggested-case-notes__control-group suggested-case-notes__control-group--right">
            {% if widget.highlightToggleHref and widget.highlightToggleText %}
                <a class="suggested-case-notes__control govuk-link govuk-link--no-visited-state" href="{{ widget.highlightToggleHref }}" data-qa="toggle-highlights">{{ widget.highlightToggleText }}</a>
            {% endif %}
            <button class="suggested-case-notes__control case-note-card__show-all-btn govuk-link govuk-link--no-visited-state" type="button" hidden aria-expanded="false" data-qa="expand-all-case-notes">Expand all case notes</button>
        </div>
    </nav>
    {% if widget and widget.notes and widget.notes.length %}
        {% for note in widget.notes %}
            <article class="card case-note-card govuk-!-margin-bottom-4" data-qa="suggested-case-notes-card">
                <div class="case-note-card__header-info govuk-!-margin-bottom-3">
                    <div class="case-note-card__header-text">
                        <div class="case-note-card__date-line">
                            <h3 class="govuk-heading-m govuk-!-margin-bottom-0 case-note-card__date">{{ (note.createdAt | formatDisplayDateWith24HourTime) or 'Suggested note ' + loop.index }}</h3>
                            {% if note.location %}<p class="govuk-body-s govuk-!-margin-bottom-0 case-note-card__prison-name">{{ note.location }}</p>{% endif %}
                            {% if note.type %}<p class="govuk-body-s govuk-!-margin-bottom-0 case-note-card__type"><span class="moj-badge moj-badge--green">{{ note.type }}</span></p>{% endif %}
                        </div>
                        {% if note.createdBy %}<p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0 case-note-card__created-by">{{ note.createdBy }}</p>{% endif %}
                    </div>
                </div>

                <div class="case-note-card__details">
                    <div class="case-note-card__text-wrapper" data-truncatable-text>
                    <p class="govuk-body govuk-!-margin-bottom-3 case-note-card__text" data-truncatable-content>
                        {% if widget.showHighlighting and note.textFragments %}
                            {% for fragment in note.textFragments %}
                                {% if fragment.highlighted %}
                                    <span data-truncatable-fragment="highlight"><mark class="hods-highlight"><strong>{{ fragment.text }}</strong></mark></span>
                                {% else %}
                                    <span data-truncatable-fragment="plain">{{ fragment.text }}</span>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <span data-truncatable-fragment="plain">{{ note.caseNoteText }}</span>
                        {% endif %}
                    </p>
                    </div>
                    {% if note.amendments and note.amendments.length %}
                        <div class="case-note-card__amendments govuk-inset-text">
                            <h4 class="govuk-heading-m case-note-card__amendments-heading govuk-visually-hidden">More details</h4>
                        {% for amendment in note.amendments %}
                            <div class="case-note-card__amendment">
                                <h5 class="govuk-heading-s">{{ amendment.createdAt | formatDisplayDateWith24HourTime }}</h5>
                                <div class="case-note-card__text-wrapper" data-truncatable-text>
                                <p class="govuk-body case-note-card__text" data-truncatable-content>
                                    {% if widget.showHighlighting %}
                                        {% for fragment in amendment.textFragments %}{% if fragment.highlighted %}<span data-truncatable-fragment="highlight"><mark class="hods-highlight"><strong>{{ fragment.text }}</strong></mark></span>{% else %}<span data-truncatable-fragment="plain">{{ fragment.text }}</span>{% endif %}{% endfor %}
                                    {% else %}
                                        {% for fragment in amendment.textFragments %}<span data-truncatable-fragment="plain">{{ fragment.text }}</span>{% endfor %}
                                    {% endif %}
                                </p>
                                </div>
                            </div>
                            {% if not loop.last %}<hr class="govuk-section-break govuk-section-break--s govuk-section-break--visible govuk-!-margin-top-3 govuk-!-margin-bottom-3">{% endif %}
                        {% endfor %}
                        </div>
                    {% endif %}
                </div>
                <div class="case-note-card__footer">
                    <button class="govuk-link govuk-link--no-visited-state case-note-card__show-all-btn" type="button" hidden aria-expanded="false" data-qa="expand-case-note">Expand case note</button>
                </div>
            </article>
        {% endfor %}
    {% else %}
        <div class="govuk-inset-text govuk-!-margin-top-2" data-qa="suggested-case-notes-empty-message">
            {{ widget.emptyStateMessage if widget else 'No suggested case notes are available for this record right now.' }}
        </div>
    {% endif %}
</section>
